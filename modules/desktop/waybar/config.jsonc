// https://man.archlinux.org/man/extra/waybar/waybar-hyprland-workspaces.5.en
[
  {
    "layer": "top",
    "position": "top",
    "height": 24,
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["disk", "memory", "cpu", "clock"],
    "hyprland/workspaces": {
      "sort-by": "id",
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "default": "󰋙",
        "active": "󰫈",
        "steam": "",
        "brave": "",
        "audio": "",
      },
    },
  },
]
